{
  "manifest_version": 3,
  "name": "DURL Download Manager",
  "version": "1.0.0",
  "description": "Intercept browser downloads and send them to DURL Download Manager.",

  "permissions": [
    "downloads",
    "cookies",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:19283/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

